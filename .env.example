# Nunca compartilhe seu token. Preencha somente no seu computador/host.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Node 24.17+; um único processo por banco de dados.
DATABASE_PATH=./data/sanatorio.sqlite
LOG_LEVEL=info
# Sincroniza os comandos ao iniciar. "auto" atualiza a guild e também um catálogo global já existente.
AUTO_DEPLOY_COMMANDS=true
AUTO_DEPLOY_SCOPE=auto
# Console colorido/interativo somente quando a hospedagem fornece TTY. 0 desativa a limpeza periódica.
INTERACTIVE_CONSOLE=true
CONSOLE_CLEAR_MINUTES=30
# Opcionais: GuildMembers e MessageContent são intents privilegiadas.
ENABLE_MEMBERS_INTENT=true
ENABLE_MESSAGE_CONTENT_INTENT=true
# Opcional para /verificarusuario mostrar status, dispositivo e atividades.
ENABLE_PRESENCES_INTENT=false
# Apenas diagnóstico local. Não precisa abrir uma porta para usar o bot.
HEALTH_PORT=0
# Chatbot e sugestões inteligentes (crie a chave em console.groq.com).
